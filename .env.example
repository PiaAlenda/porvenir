# ---------------------------------------------------------------------------
# Desarrollo local
# ---------------------------------------------------------------------------
# Sin estas variables la app funciona igual, pero guarda los datos en
# archivos locales (server/data). Para trabajar contra Supabase, completalas.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Correo con acceso al panel. Tiene que coincidir exactamente con el usuario
# creado en Supabase Auth (Dashboard > Authentication > Users). Es la única
# allow-list que decide quién entra: cualquier otra cuenta del proyecto queda
# rechazada aunque la contraseña sea correcta.
# En producción esta variable es obligatoria: sin ella el servicio no arranca.
ADMIN_EMAIL=admin@escuela.com
# Si el panel necesita más de un usuario, listalos separados por coma.
# Si lo definís, ADMIN_EMAIL se ignora por completo.
# ADMIN_EMAILS=admin@escuela.com,secretaria@escuela.com

# Solo en modo local (sin Supabase). Se ignora si usás Supabase Auth.
ADMIN_PASSWORD=poner-una-clave-segura

# ---------------------------------------------------------------------------
# Solo en Render (producción)
# ---------------------------------------------------------------------------
# Origen del frontend en Vercel, separado por coma si hay varios.
# La comparación es exacta (sin barra final, sin comodines): un origen que no
# esté en la lista hace que el navegador rechace la respuesta por CORS. Y con
# la lista vacía los pedidos con Origin se rechazan, no se aceptan todos.
ALLOWED_ORIGIN=https://tu-app.vercel.app

# Con NODE_ENV=production el servidor NO arranca si falta SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, ALLOWED_ORIGIN, ADMIN_EMAIL/ADMIN_EMAILS, o si
# ADMIN_PASSWORD quedó con el valor por defecto. Es deliberado: en producción
# es preferible que el deploy falle visible a que quede medio configurado.
NODE_ENV=production

# Ponelo en 1 si querés que el servidor de Express sirva el build de Vite.
# Con el frontend en Vercel, dejalo en 0.
SERVE_STATIC=0

# ---------------------------------------------------------------------------
# Solo en Vercel (build del frontend)
# ---------------------------------------------------------------------------
# URL de la API en Render, sin barra final.
# Si falta, el bundle pide /api/* al propio dominio y en Vercel eso es un SPA
# estático: todo /api/* responde 404. Por eso el build en Vercel aborta si esta
# variable no está definida, en vez de publicar un bundle inservible.
VITE_API_URL=https://tu-servicio.onrender.com