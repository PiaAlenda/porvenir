{
  "name": "obreros-por-venir",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,yellow \"vite\" \"node --env-file=.env server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --env-file=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "img:convert": "node scripts/convert-to-webp.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "node --env-file=.env server/index.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.11",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.13",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
